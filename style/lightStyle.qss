/* QWidget (Light Mode) */
QWidget {
    font-size: 14px;
    font-weight: 600;
    color: #3D315B;
}

QMainWindow {
    background-color: #F2E9FF;
}

/* QPushButton (Light Mode) */
QAbstractButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7A71E7, stop:1 #5A4EA6); /* Gradient for regular state */
    border: 2px solid #5A4EA6; /* Border color for regular state */
    border-radius: 5px;
    padding: 8px 16px;
    color: white; /* Text color for regular state */
}

QAbstractButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5A4EA6, stop:1 #7A71E7); /* Gradient for hover state */
}

QAbstractButton:pressed {
    background-color: #3D315B; /* Background color for pressed state */
    border: 2px solid #7A71E7; /* Border color for pressed state */
    color: white; /* Text color for pressed state */
}

QAbstractButton:disabled {
    background-color: #5A4EA6; /* Background color for disabled state */
    color: #A095C7; /* Text color for disabled state */
}

QComboBox {
    border: 2px solid #5A4EA6; /* Border color */
    border-radius: 5px;
    padding: 4px 8px;
    color: #3D315B; /* Dark text color */
    background-color: transparent;
}

QComboBox QAbstractItemView {
    background-color: #F2E9FF; /* Light background color */
    border: 1px solid #5A4EA6; /* Border color */
    border-radius: 5px; /* Rounded corners */
    selection-background-color: #7A71E7;
    color: #3D315B;
}

QLineEdit {
    background-color: transparent; /* Light background color */
    border: 2px solid #3D315B; /* Border color */
    border-radius: 20px;
    padding: 4px 8px;
}

QTextEdit {
    background-color: transparent;
    border: none;
    font-size: 22px;
}

QMenu {
    background-color: #F2E9FF; /* Light background color */
    border: 1px solid #5A4EA6; /* Border color */
    border-radius: 5px; /* Rounded corners */
}

QMenu::item {
    padding: 4px 20px; /* Padding for menu items */
    background-color: transparent; /* Transparent background for items */
}

QMenu::item:selected {
    background-color: #7A71E7; /* Background color for selected item */
}

QMenu::item:disabled {
    color: #B3A6C9; /* Color for disabled items */
    background-color: transparent; /* Transparent background for disabled items */
}

QToolButton {
    font-weight: bold;
    border: none;
    background-color: transparent;
    color: #3D315B;
}

QToolButton:hover, QToolButton:pressed {
    font-weight: bold;
    border: none;
    background-color: transparent;
    color: #3D315B;
}

QCalendarWidget QAbstractItemView
{
    background-color: #F2E9FF;
    selection-background-color: #3D315B; /* the color of the selected cell */
    selection-color: #F2E9FF; /* the color of the selected cell's text */
}

/* header row */
QCalendarWidget QWidget {
    alternate-background-color: #F2E9FF;
}

/* navigation bar */
QCalendarWidget QWidget#qt_calendar_navigationbar
{
    background-color: #F2E9FF;
}









